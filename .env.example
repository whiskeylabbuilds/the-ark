# The Ark settings. install.sh creates .env from this file and fills in the marked values.
# Quote values that contain spaces or "&".

# Which compose files to use (install.sh sets this): the base file, plus the graphics-card file
# (compose.nvidia.yml or compose.amd.yml; none = AI on the CPU), plus local/compose.yml if you have one.
COMPOSE_FILE=docker-compose.yml

# This machine's LAN address (install.sh fills it in; setup/04-auto-host-addr.sh keeps it current).
HOST_ADDR=
# Other names people may type to reach the Ark (comma-separated, lowercase).
# <hostname>.local works on most phones and laptops; many routers also resolve the bare hostname.
ARK_NAMES=ark.local,ark

# Where all downloaded content and app data lives (~250 GB with the default content).
ARK_DATA=/srv/ark
# Your user and group id, so the music library and notes can read and write your files (install.sh fills these in).
ARK_UID=1000
ARK_GID=1000

TZ=UTC

# Any long random string (install.sh generates one). By hand: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me

# FlatNotes login: "none" (anyone on the Wi-Fi can edit) or "password"
# (then also set FLATNOTES_USERNAME / FLATNOTES_PASSWORD / FLATNOTES_SECRET_KEY
# and add them to the flatnotes service in docker-compose.yml).
FLATNOTES_AUTH_TYPE=none

# Offline map (scripts/build-maps.sh): west,south,east,north in degrees, from https://bboxfinder.com
# Example below: Texas, Oklahoma, Arkansas and Louisiana (~2 GB at full detail).
MAP_BBOX=
MAP_REGION_NAME="Regional map"
# MAP_BBOX=-106.7,25.8,-88.8,37.1
# MAP_REGION_NAME="Texas, Oklahoma, Arkansas, Louisiana"

# MeshCore radio (port 8086). "auto" = first USB radio found. If a Meshtastic radio is
# plugged in too, point this at the MeshCore one: ls /dev/serial/by-id/
MC_SERIAL_PORT=auto
MC_DEVICE_NAME="The Ark"

# Ask the Ark API key for scripts/setup-ai.sh and scripts/sync-knowledge.py
# (Settings → Account → API Keys → Create). Keep it secret.
OPENWEBUI_API_KEY=

# Bookshelf shelves whose PDFs are indexed as page-by-page text (keeps spec tables intact), comma-separated.
LAYOUT_TEXT_SHELVES="Vehicles & Equipment"

# AMD cards only, if Ollama doesn't detect yours (e.g. 10.3.0 for RX 6600-class cards).
# HSA_OVERRIDE_GFX_VERSION=
